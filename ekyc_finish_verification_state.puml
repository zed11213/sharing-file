@startuml ekyc_finish_verification_state
title eKYC 完了処理 (AB1202 JPKI / AB1203 He 共通) : 中央=正常系 / 左右=異常系へ分岐

skinparam shadowing false

'==== 開始 ====
[*] --> d0

'==== パラメータチェック（不備は左へ） ====
state d0 <<choice>>
state "例外\n400 BadRequest" as ex400 #ffd8b0
d0 -left-> ex400 : パラメータ不備
d0 -down-> s1 : OK

'==== 申請情報登録API ====
state "申請情報登録API 呼出" as s1 #e8f5ff
state d1 <<choice>>
state "return null" as null1 #ffdddd
s1 --> d1
d1 -right-> null1 : 登録失敗
d1 -down-> s2 : 成功

'==== ekyc から情報取得（allOf 並列） ====
state "ekyc から情報取得" as s2 #e8f5ff
state fork1 <<fork>>
state "画像取得API"                         as p1 #e8f5ff
state "自動判定結果API\n(1秒間隔リトライ×59回)" as p2 #e8f5ff
state "ICカード読取API"                      as p3 #e8f5ff
s2 --> fork1
fork1 --> p1
fork1 --> p2
fork1 --> p3
state join1 <<join>>
p1 --> join1
p2 --> join1
p3 --> join1

'==== 取得成功チェック（失敗は左へ） ====
state d2 <<choice>>
state "throw 例外\n(リクエスト読取失敗)" as ex2 #ffd8b0
join1 --> d2
d2 -left-> ex2 : 取得失敗
d2 -down-> s3 : 成功

'==== 本人画像を iCOS 保存 ====
state "本人画像・判定結果画像を\niCOS 保存" as s3 #e8f5ff
state d3 <<choice>>
state "throw 例外\n(iCOS 保存失敗)" as ex3 #ffd8b0
s3 --> d3
d3 -right-> ex3 : 保存失敗
d3 -down-> s4 : 保存成功

'==== 判定結果画像作成〜再保存 ====
state "判定結果画像作成"              as s4 #e8f5ff
state "本人画像・判定結果画像を\niCOS 保存" as s5 #e8f5ff
s4 --> s5

'==== ABA 登録〜正常終了 ====
state "申請情報を ABA に登録\n(個人:登録 / 法人&個人事業主:更新)" as s6 #e8f5ff
state "return 受付番号"        as s7 #ddffdd
state "本人確認結果登録API"     as s8 #e8f5ff
s5 --> s6
s6 --> s7
s7 --> s8
s8 --> [*]

@enduml
