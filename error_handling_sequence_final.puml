@startuml error_handling_sequence_final

participant "前端\n(Repository/API层)" as FE
participant "ResponseInterceptor" as RI
participant "后台(Controller)" as BFF
participant "RestTemplate" as RT
participant "RestClientErrorHandler" as EH
participant "后端服务(BA/ABA)" as BE
participant "POPWindowsUtil\n(LiveData)" as POP
participant "UI层\n(全局错误Dialog)" as UI

FE -> RI : ①发起请求(chain.request())
activate RI
RI -> BFF : ②chain.proceed(request)
BFF -> RT : 调用后端接口
RT -> BE : ③转发HTTP请求
BE --> RT : 返回错误(4xx/5xx)
RT -> EH : ④hasError()=true\n触发handleError()

note over EH
  解析Body,判断BA/ABA
  组装errorCode/errorMsg
end note

EH --> BFF : ⑤抛出对应异常\n(如BadRequestException)
BFF --> RI : ⑥返回错误Response

alt HTTP 200(APIGW)
    RI -> RI : newResponseCreate()解密响应体
else HTTP 412
    RI -> RI : RefreshLogic.az0903()刷新令牌
    alt 刷新成功
        RI -> BFF : signedRequest()重新签名并重试
    else 刷新失败
        RI -> RI : showErrorMsgDialog(it)
    end
else HTTP 426
    RI -> RI : VersionUpdateUtil.postValue()
else HTTP 400 / 418 / 500
    RI -> RI : ⑦showErrorMsgDialog(it)
else HTTP 530
    RI -> POP : postValue(维护中消息)
else 其他(API_401_RETRY_FLAG=true)
    RI -> POP : postValue(errorMsg)
end

note over RI
  showErrorMsgDialog:
  解析ErrorResponseBean → editErrorMsg()
  按API_SERVICE_NAME定制文案
end note

alt errorCode == MBFS0008
    RI -> RI : MBFS0008ErrorUtil.postValue(errorMsg)
else 其他errorCode
    RI -> POP : ⑧postValue(errorMsg, errorTitle, errorCode)
end
deactivate RI

RI --> POP : (网络异常IOException,非Canceled时)\nonFailure同样postValue

POP -> UI : ⑨通知LiveData变化
UI -> UI : ⑩展示错误 AlertDialog

@enduml
