@startuml ekyc_finish_verification
title eKYC 完了処理フロー (setFinishVerification)\nPOST /ekyc/AB1202 (JPKI) / POST /ekyc/AB1203 (He) ※両者は同一フロー

start

:createRequestInformationDto\n申請情報DTO作成;

:requestInformation\n申請情報登録API\n(LIQUID Connector へ REST 呼出);
note right
  EkycRemoteApiException / Exception
  発生時は throw して異常終了
end note

if (requestResult == FAIL?) then (yes)
  #ffdddd:return null;
  stop
endif

:requestAllData\n情報取得 (CompletableFuture.allOf 並列);
note right
  並列取得 3本:
  - getPhotos ... 画像データ取得
  - getVerificationResult ... 自動判定結果
    (facePhoto=null なら 9秒 sleep→1回リトライ,
     なお null なら RuntimeException)
  - getIdDocumentInformation ... ICカード読取情報
  いずれか失敗 → throw EkycRemoteApiException
  (リクエスト読取失敗)
end note

fork
  :getPhotos\n画像データ取得;
fork again
  :getVerificationResult\n自動判定結果;
fork again
  :getIdDocumentInformation\nICカード読取情報;
end fork

if (verificationResult == null?) then (yes)
  #ffdddd:return null;
  stop
endif

:checkTheVerificationResults\n自動判定結果チェック;

if (checkResult == FAIL?) then (yes)
  #ffdddd:return null;
  stop
endif

if (verificationJoinedData / photos が null?) then (yes)
  #ffdddd:return null;
  stop
endif

:storePhotosToICOS\n本人容貌画像を iCOS に保存;
note right
  Exception 発生時は
  throw EkycRemoteApiException
  (Failed to store iCOS)
end note

:storeVerificationResultImageToICOS\n判定結果画像を iCOS に保存 → list 追加;
note right
  Exception 発生時:
  - JPKI(AB1202): InternalServerErrorException
  - He (AB1203): EkycRemoteApiException
end note

if (idDocumentInformation == null?) then (yes)
  #ffdddd:return null;
  stop
endif

if (list が null / 空?) then (yes)
  #ffdddd:return null;
  stop
endif

:storeRequestInformationToABA\n申請情報を ABA に登録;

if (personType?) then (個人 INDIVIDUAL)
  :accountOpenAppliIndividualContentRegistration\n口座開設申込内容登録 (個人);
else (法人 CORPORATE)
  :accountOpenAppliContentUpdate\n口座開設申込内容更新 (法人);
endif

:receptionNumber 受付番号 取得;
note right
  ※ 末尾の getKycResult
  (KYC結果登記API) は
  現状 //TODO でコメントアウト
end note

#ddffdd:return receptionNumber\nJsonResult.success;
stop

@enduml
